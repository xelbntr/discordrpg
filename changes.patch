+class TransitionTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.user = SimpleNamespace(id=1)
+        self.saved = new_run()
+
+        async def update(user, state_id, **fields):
+            if self.saved is None or user.id != self.saved['user_id'] or state_id != self.saved['state_id']:
+                return None
+            self.saved.update(copy.deepcopy(fields), state_id=uuid4())
+            return copy.deepcopy(self.saved)
+
+        async def fetch(user, **fields):
+            return {"run": copy.deepcopy(self.saved)}
+
+        self.update = AsyncMock(side_effect=update)
+        self.fetch = AsyncMock(side_effect=fetch)
+        self.patchers = [
+            patch.object(db, 'update_run_state', self.update),
+            patch.object(db, 'fetch', self.fetch),
+        ]
+        for patcher in self.patchers:
+            patcher.start()
+            self.addCleanup(patcher.stop)
+
+    async def generate(self, floor=1):
+        return await run_lib.generate_rooms(self.user, 0, floor, state_id=self.saved['state_id'])
+
+    async def test_confirmation_generates_before_render(self):
+        event = interaction(self.user)
+        confirmation = run_ui.RunConfirmationView(self.user)
+        with patch.object(db, 'create_run', AsyncMock(return_value=copy.deepcopy(self.saved))):
+            await run_lib.start_run(event, confirmation)
+        event.response.defer.assert_awaited_once()
+        screen = event.edit_original_response.await_args.kwargs
+        self.assertEqual(screen['embed'].title, 'Basecamp')
+        self.assertIsInstance(screen['view'], run_ui.BasecampView)
+        self.assertEqual(len(self.saved['room_sequence']), 6)
+        self.assertEqual(self.saved['current_room'], 0)
+        self.assertTrue(confirmation.is_finished())
+
+    async def test_duplicate_confirmation_resumes_existing_state(self):
+        await self.generate()
+        self.saved.update(room_completed=True)
+        before = copy.deepcopy(self.saved)
+        event = interaction(self.user)
+        with patch.object(db, 'create_run', AsyncMock(return_value=None)):
+            await run_lib.start_run(event, run_ui.RunConfirmationView(self.user))
+        self.assertEqual(self.saved, before)
+        self.assertIsInstance(event.edit_original_response.await_args.kwargs['view'], run_ui.MapSelectionView)
+
+    async def test_cancel_does_not_create_a_run(self):
