+def new_run(**fields):
+    run = {
+        "user_id": 1, "hp": 100, "xp": 0, "run_level": 1,
+        "rank_snapshot": 0, "deck": [], "current_floor": 1,
+        "current_room": 0, "room_sequence": [], "room_completed": False,
+        "pending_levels": [], "card_choices": [], "state_id": uuid4(),
+    }
+    run.update(fields)
+    return run
+
+
+def interaction(user):
+    return SimpleNamespace(
+        user=user,
+        response=SimpleNamespace(defer=AsyncMock(), send_message=AsyncMock(), edit_message=AsyncMock()),
+        followup=SimpleNamespace(send=AsyncMock()),
+        edit_original_response=AsyncMock(),
+    )
+
