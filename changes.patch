+                self.assertEqual(run_ui.run_screen(self.user, run)[0].title, ROOMS[room_name].embed.room_title)
+                run = await run_lib.complete_room(self.user, run, xp=100 if room_name == 'battle' else 0)
+                self.assertEqual(run['current_room'], index)
+                while run['pending_levels']:
+                    resumed = await run_lib.load_run(self.user)
+                    self.assertEqual(resumed['card_choices'], run['card_choices'])
+                    self.assertIsInstance(run_ui.run_screen(self.user, resumed)[1], run_ui.CardSelectionView)
+                    run = await run_lib.choose_card(self.user, resumed, resumed['card_choices'][0])
+                resumed = await run_lib.load_run(self.user)
+                self.assertEqual(resumed, run)
+                if floor == 4 and index == 5:
+                    self.assertTrue(run_lib.run_finished(run))
+                    self.assertIsInstance(run_ui.run_screen(self.user, run)[1], run_ui.VictoryView)
+                    self.assertIsNone(await run_lib.move_room(self.user, run))
+                else:
+                    self.assertIsInstance(run_ui.run_screen(self.user, run)[1], run_ui.MapSelectionView)
+                    run = await run_lib.move_room(self.user, run)
+                    self.assertFalse(run['room_completed'])
+                    self.assertEqual(run['pending_levels'], [])
+
+    async def test_multiple_levelups_finish_before_map(self):
+        run = await self.generate()
+        run = await run_lib.complete_room(self.user, run, xp=600)
+        self.assertEqual(run['pending_levels'], [2, 3, 4, 5])
+        self.assertIsNone(await run_lib.move_room(self.user, run))
+        self.assertIsNone(await run_lib.choose_card(self.user, run, 'Missing card'))
+        for level in [2, 3, 4, 5]:
+            embed, view = run_ui.run_screen(self.user, run)
+            self.assertIn(str(level), embed.title)
+            event = interaction(self.user)
+            old_view = view
+
+            async def edit(**kwargs):
+                self.assertTrue(old_view.is_finished())
+
+            event.edit_original_response.side_effect = edit
+            await view.children[0].callback(event)
+            run = await run_lib.load_run(self.user)
