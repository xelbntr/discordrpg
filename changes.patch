+
+    async def test_full_four_floor_loop_and_resume(self):
+        run = await self.generate()
+        for floor in range(1, 5):
+            for index in range(6):
+                self.assertEqual((run['current_floor'], run['current_room']), (floor, index))
+                room_name = run['room_sequence'][index]
