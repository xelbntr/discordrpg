+        await view.cancel_run.callback(event)
+        self.update.assert_not_awaited()
+        self.fetch.assert_not_awaited()
+        self.assertTrue(view.is_finished())
+
+    async def test_all_placeholder_views_report_completion(self):
+        for room_name, room in ROOMS.items():
+            with self.subTest(room=room_name):
+                self.saved = new_run(room_sequence=[room_name, 'boss'])
+                embed, view = run_ui.run_screen(self.user, copy.deepcopy(self.saved))
